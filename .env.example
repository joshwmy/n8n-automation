# Copy this file to .env and fill in real values:
#   cp .env.example .env
# .env is gitignored (see .gitignore) — never commit it.

# --- Image version ---
# Pinned, not "latest" — keeps `docker compose up` reproducible. Check
# https://github.com/n8n-io/n8n/releases for newer stable versions before
# bumping this.
N8N_VERSION=2.34.4

# --- Required: credential encryption key ---
# n8n uses this to encrypt saved credentials (e.g. the Google Sheets
# OAuth2 credential) inside the persistent volume. Generate one and keep
# it safe outside git — losing it means n8n can no longer decrypt
# credentials already saved in the volume.
#   Windows PowerShell:  -join ((48..57)+(97..102)|Get-Random -Count 64|%{[char]$_})
#   macOS/Linux:         openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace_with_a_generated_random_string

# --- Timezone ---
# Used by n8n's Schedule Trigger (the "Every 4 Hours - Check Overdue
# Deposits" node in this workflow) and displayed timestamps.
GENERIC_TIMEZONE=Indian/Mauritius
TZ=Indian/Mauritius

# --- Local-only access ---
# Phase 1 is local-only: no tunnel, no public exposure. Don't change
# N8N_PROTOCOL to https or N8N_HOST away from localhost unless you are
# deliberately changing that.
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false

# --- Production only (docker-compose.prod.yml) ---
# Leave unset for local dev. Required when running with the prod overlay:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#
# WEBHOOK_URL: the public HTTPS URL n8n uses to generate reachable form-
# trigger/webhook URLs. Must match the domain the reverse proxy terminates
# TLS for.
# EDGE_NETWORK_NAME: name of an already-existing external Docker network
# that the host's reverse proxy container is also attached to, so it can
# reach n8n by service name without any new host port being opened.
#WEBHOOK_URL=https://n8n.example.org/
#EDGE_NETWORK_NAME=academious_edge
